# Draft HaikuPorts recipe for Minuta (untested with haikuporter).
# Before submitting: the repository needs a public release tag that
# includes src/haiku (the current v0.1.0 tag predates the Haiku port);
# rename the recipe to that version and fill in CHECKSUM_SHA256 for its
# archive.
SUMMARY="A minimal Markdown editor"
DESCRIPTION="Minuta is a minimal Markdown editor in the spirit of iA Writer: \
one centered column of monospace text, Markdown syntax kept visible but \
dimmed, focus mode, typewriter scrolling and a night theme. It has a \
preview, HTML export, word count and find, and reads UTF-8 and \
Windows-1252 files, keeping their encoding and line endings on save."
HOMEPAGE="https://github.com/breakzplatform/minuta"
COPYRIGHT="2026 Joselito"
LICENSE="GNU GPL v3"
REVISION="1"
SOURCE_URI="https://github.com/breakzplatform/minuta/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256=""
SOURCE_DIR="minuta-$portVersion"

ARCHITECTURES="all !x86_gcc2"
SECONDARY_ARCHITECTURES="x86"

PROVIDES="
	minuta$secondaryArchSuffix = $portVersion
	app:Minuta = $portVersion
	"
REQUIRES="
	haiku$secondaryArchSuffix
	"

BUILD_REQUIRES="
	haiku${secondaryArchSuffix}_devel
	"
BUILD_PREREQUIRES="
	cmd:gcc$secondaryArchSuffix
	cmd:make
	cmd:mimeset
	cmd:rc
	cmd:xres
	"

BUILD()
{
	make -C src/haiku $jobArgs
}

INSTALL()
{
	mkdir -p $appsDir
	cp src/haiku/objects/Minuta $appsDir/
	addAppDeskbarSymlink $appsDir/Minuta
}
