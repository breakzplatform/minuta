resource app_signature "application/x-vnd.Minuta";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major = 0,
	middle = 1,
	minor = 1,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Minuta",
	long_info = "Minuta 0.1.1, a minimal Markdown editor"
};

resource file_types message {
	"types" = "text/markdown",
	"types" = "text/x-markdown",
	"types" = "text/plain"
};
