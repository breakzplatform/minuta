name			minuta
version			@VERSION@
architecture	@ARCH@
summary			"A minimal Markdown editor"
description		"Minuta is a minimal Markdown editor in the spirit of iA Writer: one centered column of monospace text, with the Markdown syntax kept visible but dimmed. It has focus mode, typewriter scrolling, full screen, a night theme, a preview, HTML export, word count and find. It reads UTF-8 and Windows-1252 files and keeps their encoding and line endings when saving."
packager		"Joselito Junior <eu@joseli.to>"
vendor			"Joselito Junior"
licenses {
	"GNU GPL v3"
	"MIT"
}
copyrights {
	"2026 Joselito Junior"
}
urls {
	"https://github.com/breakzplatform/minuta"
}
provides {
	minuta = @VERSION@
	app:Minuta = @VERSION@
	cmd:minuta = @VERSION@
}
requires {
	haiku
}
